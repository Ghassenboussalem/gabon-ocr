# Copy this file to .env and fill in your values.
# run_pipeline.py loads .env automatically (real env vars still take precedence).

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional fallback keys, used in order when the previous key's quota is exhausted:
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional: path to the Tesseract binary if it isn't on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OpenCRVS integration (tools/send_to_opencrvs.py) — create an
# "Event notification" client in the OpenCRVS admin UI to get these.
# OPENCRVS_AUTH_URL=http://localhost:4040
# OPENCRVS_GATEWAY_URL=http://localhost:7070
# OPENCRVS_CLIENT_ID=
# OPENCRVS_CLIENT_SECRET=
# OPENCRVS_LOCATION_ID=
