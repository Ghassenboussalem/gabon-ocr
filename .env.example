# Copy this file to .env and fill in your values.
# run_pipeline.py loads .env automatically (real env vars still take precedence).

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional fallback keys, used in order when the previous key's quota is exhausted:
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional: path to the Tesseract binary if it isn't on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
